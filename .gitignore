# Claude state — project memory (.claude/mind.mv2) is tracked; lock files are not
.claude/*.lock

# Rust build artifacts
target/
**/*.rs.bk

# Editor and OS noise
*.swp
*.swo
.DS_Store
Thumbs.db

# ONNX model artifacts (export via scripts/export_models.py)
# The new torch ONNX exporter writes weights to *.onnx.data alongside the graph file.
models/*.onnx
models/*.onnx.data

# Python venv for export scripts
scripts/.venv/
experiments/**/.claude/

# generated test artifacts
test.mp4
*.ndjson

# Large regenerable runtime artifacts
memory/snapshot/
memory/warm/
memory/episodes.cold
memory_baseline_backup/
clips/
models/*.safetensors
models/qwen25_tokenizer.json
models/whisper_tokenizer.json
memory/somnus.pid
scripts/__pycache__/
