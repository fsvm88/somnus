# Claude state — project memory (.claude/mind.mv2) is regenerable at runtime, not tracked
.claude/mind.mv2
.claude/*.lock
.claude/projects/
" .claude"/

# Rust build artifacts
target/
**/*.rs.bk

# Editor and OS noise
*.swp
*.swo
.DS_Store
Thumbs.db

# ONNX model artifacts (export via scripts/export_models.py)
# The new torch ONNX exporter writes weights to *.onnx.data alongside the graph file.
models/*.onnx
models/*.onnx.data

# Python venv for export scripts
scripts/.venv/
.venv/
# Isolated venv for EfficientAT export (torch/torchvision pin incompatible with scripts/.venv's
# pinned torch 2.11.0 — see ai-docs/gaps.md item 9)
scripts/.venv-efficientat/
scripts/.vendor-efficientat/
experiments/**/.claude/

# Raw HuggingFace checkouts used as export sources (see scripts/export_models.py) —
# regenerate via `huggingface-cli download`, don't commit. (models/qwen25_hf/ was
# accidentally committed 2026-06 and removed 2026-07-05.)
models/*_hf/

# Scratch symlink farms some A/B scripts point --models-dir at (e.g. models_control/,
# models_lora_ab_control/) — just symlinks into models/, never meant to be tracked.
/models_*/

# Ad hoc session/run logs and backup files, anywhere in the tree (ai-docs/ holds the
# durable write-ups; regenerate logs/backups instead of committing them)
*.log
*.bak

# Experiment build byproducts (source is tracked; binaries are not)
experiments/*/target/
experiments/*/Cargo.lock

# generated test artifacts
test.mp4
*.ndjson

# Runtime data — everything under memory/ is regenerable at runtime.
# Nothing here belongs in version control.
memory/
memory_baseline_backup/

# Python bytecode
__pycache__/
*.pyc

# Input data and large binary assets
data/
clips/
models/*.safetensors
models/qwen25_tokenizer.json
models/whisper_tokenizer.json
